NODE_ENV=development
PORT=3000
# Comma separated list of origins allowed to call the API
CORS_ORIGIN=http://localhost:5173

# Postgres connection. For Supabase, use the values from
# Project Settings > Database and set DB_SSL=true.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
# Wrap the password in double quotes if it contains a `#`
DB_PASSWORD=
DB_NAME=simple_invoice
DB_SSL=false

# Use a long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`
JWT_SECRET=
# Access token lifetime in seconds (defaults to 3600)
JWT_EXPIRES_IN=3600

# Reviewer account created by `npm run seed`
SEED_USER_EMAIL=admin@simpleinvoice.dev
SEED_USER_PASSWORD=
SEED_USER_FULLNAME=Admin User
